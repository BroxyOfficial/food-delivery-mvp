{
  "name": "food-delivery-mvp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:mobile": "npm run start --workspace apps/mobile",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "db:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=apps/api/prisma/schema.prisma",
    "db:seed": "node apps/api/scripts/seed.js",
    "lint:web": "npm run lint --workspace apps/web"
  },
  "devDependencies": {
    "prisma": "^5.17.0"
  }
}
